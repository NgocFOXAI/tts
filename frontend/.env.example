# ===========================================
# Frontend Environment Configuration
# ===========================================

# Development Server Configuration
PORT=3000
HTTPS=false
FAST_REFRESH=true
GENERATE_SOURCEMAP=true

# API Configuration
REACT_APP_API_URL=https://url.com.vn
REACT_APP_API_TIMEOUT=3000000
REACT_APP_API_RETRY_ATTEMPTS=3
REACT_APP_API_RETRY_DELAY=1000

# Development Configuration
REACT_APP_ENV=development
REACT_APP_DEBUG=true
REACT_APP_LOG_LEVEL=info

# Application Configuration
REACT_APP_NAME=AI Text & Speech Platform
REACT_APP_VERSION=1.0.0
REACT_APP_DESCRIPTION=Advanced AI-powered text generation and speech synthesis platform
REACT_APP_AUTHOR=AI Development Team

# Model Configuration
REACT_APP_DEFAULT_MAX_TOKENS=500
REACT_APP_DEFAULT_TEMPERATURE=0.7
REACT_APP_DEFAULT_TOP_P=0.9
REACT_APP_DEFAULT_FREQUENCY_PENALTY=0
REACT_APP_DEFAULT_PRESENCE_PENALTY=0

# Text-to-Speech Configuration
REACT_APP_DEFAULT_TTS_VOICE=alloy
REACT_APP_DEFAULT_TTS_SPEED=1.0
REACT_APP_DEFAULT_TTS_PROVIDER=openai
REACT_APP_TTS_VOICES=alloy,echo,fable,onyx,nova,shimmer

# Feature Flags
REACT_APP_ENABLE_STREAMING=true
REACT_APP_ENABLE_FILE_UPLOAD=true
REACT_APP_ENABLE_TTS=true
REACT_APP_ENABLE_VOICE_CLONING=false
REACT_APP_ENABLE_BATCH_PROCESSING=true
REACT_APP_ENABLE_EXPORT_FORMATS=true
REACT_APP_ENABLE_ANALYTICS=false
REACT_APP_ENABLE_A11Y_FEATURES=true

# File Upload Configuration
REACT_APP_MAX_FILE_SIZE=10485760
REACT_APP_MAX_FILES=10
REACT_APP_SUPPORTED_FILE_TYPES=.pdf,.docx,.doc,.txt,.md,.png,.jpg,.jpeg,.bmp,.tiff,.webp
REACT_APP_UPLOAD_CHUNK_SIZE=1048576

# UI Configuration
REACT_APP_THEME=light
REACT_APP_ENABLE_DARK_MODE=true
REACT_APP_ENABLE_ANIMATIONS=true
REACT_APP_ANIMATION_DURATION=300
REACT_APP_ENABLE_SOUND_EFFECTS=true
REACT_APP_PRIMARY_COLOR=#0ea5e9
REACT_APP_SECONDARY_COLOR=#71717a

# Performance Settings
REACT_APP_DEBOUNCE_DELAY=300
REACT_APP_THROTTLE_DELAY=100
REACT_APP_CACHE_TTL=30000000
REACT_APP_MAX_HISTORY_ITEMS=100
REACT_APP_PAGINATION_SIZE=20
REACT_APP_VIRTUAL_LIST_THRESHOLD=50

# Monitoring & Analytics
REACT_APP_ENABLE_ERROR_REPORTING=true
REACT_APP_SENTRY_DSN=
REACT_APP_ANALYTICS_ID=
REACT_APP_HOTJAR_ID=
REACT_APP_GOOGLE_ANALYTICS_ID=

# Social & SEO
REACT_APP_SITE_URL=http://localhost:3000
REACT_APP_SITE_TITLE=AI Text & Speech Platform
REACT_APP_SITE_DESCRIPTION=Advanced AI-powered text generation and speech synthesis
REACT_APP_KEYWORDS=AI,text generation,text-to-speech,OpenAI,Gemini,React,TypeScript
REACT_APP_TWITTER_HANDLE=@ai_platform
REACT_APP_FACEBOOK_APP_ID=

# Security Configuration
REACT_APP_ENABLE_CSP=true
REACT_APP_TRUSTED_HOSTS=localhost,127.0.0.1,222.252.99.27
REACT_APP_API_KEY_PREFIX=app_
REACT_APP_SESSION_TIMEOUT=1800000

# Development Tools
REACT_APP_ENABLE_DEV_TOOLS=true
REACT_APP_ENABLE_REDUX_DEVTOOLS=true
REACT_APP_ENABLE_WHY_DID_YOU_RENDER=false
REACT_APP_BUNDLE_ANALYZER=false

# Internationalization
REACT_APP_DEFAULT_LOCALE=en-US
REACT_APP_SUPPORTED_LOCALES=en-US,vi-VN,zh-CN,ja-JP,ko-KR
REACT_APP_ENABLE_RTL=false

# PWA Configuration
REACT_APP_ENABLE_PWA=false
REACT_APP_PWA_NAME=AI Text & Speech Platform
REACT_APP_PWA_SHORT_NAME=AI Platform
REACT_APP_PWA_THEME_COLOR=#0ea5e9
REACT_APP_PWA_BACKGROUND_COLOR=#ffffff

# Third-party Integrations
REACT_APP_STRIPE_PUBLIC_KEY=
REACT_APP_PAYPAL_CLIENT_ID=
REACT_APP_INTERCOM_APP_ID=
REACT_APP_ZENDESK_KEY=